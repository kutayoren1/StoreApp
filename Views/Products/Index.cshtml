@{
    ViewData["Title"] = "Index";
}
@model List<Product>
<h1>Products</h1>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Description</th>
            <th>Image</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>@product.Description</td>
                <td><img src="@product.ImageUrl" alt="@product.Name" width="100" height="100" /></td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5">No products available.</td>
            </tr>
        }
    </tbody>
</table>