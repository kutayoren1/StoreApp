@{
    ViewData["Title"] = "About Us";
}
<head>
    <link rel="stylesheet" href="~/css/aboutUs.css"/>
</head>
<div class="container py-3">

    <!-- 1. THE HOOK & BRAND STORY -->
    <section class="about-hero shadow-sm">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <h1 class="display-5 fw-bold text-dark mb-3">
                    Your Gateway to Quality &amp; Trust: <span class="text-primary">StoreApp</span>
                </h1>
                <p class="lead text-muted mb-4">
                    Founded in 2026, <strong>StoreApp</strong> was born out of a passion to deliver premium, authentic products at truly accessible prices with total transparency.
                </p>
                <p class="text-secondary mb-4 lh-lg">
                    We set out to eliminate the common frustrations of online shopping—ending delayed deliveries, uncertain return procedures, and questionable authenticity. For us, commerce isn't simply about shipping a parcel; it's about delivering confidence, delight, and peace of mind with every order.
                </p>
                
                <div class="row g-3 text-center text-sm-start">
                    <div class="col-sm-4">
                        <div class="stat-badge">
                            <h3 class="fw-bold text-primary mb-1">100%</h3>
                            <small class="text-muted fw-semibold">Authentic Products</small>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="stat-badge">
                            <h3 class="fw-bold text-success mb-1">Same Day</h3>
                            <small class="text-muted fw-semibold">Fast Shipping</small>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="stat-badge">
                            <h3 class="fw-bold text-warning mb-1">24/7</h3>
                            <small class="text-muted fw-semibold">Customer Support</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="story-image-wrap">
                    <img src="~/AboutUsImages/team-story.jpg" alt="StoreApp Team Collaborating in Modern Office" class="img-fluid" />
                </div>
            </div>
        </div>
    </section>

    <!-- 2. MISSION & VISION -->
    <section class="my-5">
        <div class="text-center mb-5">
            <h2 class="fw-bold mt-1">Mission &amp; Vision</h2>
            <p class="text-muted mx-auto" style="max-width: 600px;">Driven by purpose today, building the retail standard for tomorrow.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="mission-card">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-box bg-primary bg-opacity-10 text-primary me-3 mb-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                <path d="m10.97 4.97-.02.022-3.473 4.425-2.093-2.094a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05"/>
                            </svg>
                        </div>
                        <h4 class="fw-bold mb-0 text-dark">Our Mission</h4>
                    </div>
                    <p class="text-secondary lh-lg mb-0">
                        To provide our customers with consistent, genuine satisfaction every day through <strong>100% authentic, certified products</strong>, clear pricing, and reliable after-sales support—transforming e-commerce into a joyful and trustworthy experience.
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="vision-card">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-box bg-success bg-opacity-10 text-success me-3 mb-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5.52.359A.5.5 0 0 1 6 0h4a.5.5 0 0 1 .474.658L8.694 6H12.5a.5.5 0 0 1 .395.807l-7 9a.5.5 0 0 1-.873-.454L6.823 9H3.5a.5.5 0 0 1-.48-.641z"/>
                            </svg>
                        </div>
                        <h4 class="fw-bold mb-0 text-dark">Our Vision</h4>
                    </div>
                    <p class="text-secondary lh-lg mb-0">
                        By combining modern web technology with sustainable fulfillment practices, to become the <strong>most trusted, loved, and innovative regional e-commerce destination</strong>, continuously elevating digital shopping standards.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. WHY CHOOSE US? (VALUE PROPOSITION) -->
    <section class="my-5 py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold mt-1">Why Choose Us?</h2>
            <p class="text-muted mx-auto" style="max-width: 620px;">
                High service standards grounded in uncompromising security, speed, and customer care:
            </p>
        </div>

        <div class="row g-4">
            <!-- 1. Secure Shopping -->
            <div class="col-md-6 col-lg-3">
                <div class="card feature-card p-4 shadow-sm text-center">
                    <div>
                        <div class="icon-box bg-primary bg-opacity-10 text-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2"/>
                            </svg>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-2">Secure Shopping</h5>
                    <p class="text-muted small mb-0 lh-base">
                        Protected by 256-bit SSL encryption and 3D Secure checkout, keeping your personal and payment details safe at all times.
                    </p>
                </div>
            </div>

            <!-- 2. Fast Delivery -->
            <div class="col-md-6 col-lg-3">
                <div class="card feature-card p-4 shadow-sm text-center">
                    <div>
                        <div class="icon-box bg-success bg-opacity-10 text-success">
                            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-4 0H.5A.5.5 0 0 1 0 11.5zM4 11a1 1 0 1 0 0 2 1 1 0 0 0 0-2m8 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2"/>
                            </svg>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-2">Fast Delivery</h5>
                    <p class="text-muted small mb-0 lh-base">
                        Orders placed before 4:00 PM are carefully packed and dispatched on the very same business day.
                    </p>
                </div>
            </div>

            <!-- 3. Customer Care -->
            <div class="col-md-6 col-lg-3">
                <div class="card feature-card p-4 shadow-sm text-center">
                    <div>
                        <div class="icon-box bg-warning bg-opacity-10 text-warning">
                            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 1a5 5 0 0 0-5 5v1h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a6 6 0 1 1 12 0v5a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h1V6a5 5 0 0 0-5-5"/>
                            </svg>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-2">24/7 Support &amp; Returns</h5>
                    <p class="text-muted small mb-0 lh-base">
                        Dedicated customer assistance around the clock, backed by an easy, no-questions-asked 14-day return and exchange policy.
                    </p>
                </div>
            </div>

            <!-- 4. Quality Guarantee -->
            <div class="col-md-6 col-lg-3">
                <div class="card feature-card p-4 shadow-sm text-center">
                    <div>
                        <div class="icon-box bg-info bg-opacity-10 text-info">
                            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                            </svg>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-2">Quality Guarantee</h5>
                    <p class="text-muted small mb-0 lh-base">
                        Every product in our store is thoroughly inspected and verified by our quality control team before reaching you.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- FULFILLMENT & SUSTAINABILITY -->
    <section class="my-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="story-image-wrap">
                    <img src="~/AboutUsImages/fulfillment-warehouse.jpg" alt="StoreApp Eco-Friendly Fulfillment and Warehouse Operations" class="img-fluid" />
                </div>
            </div>
            <div class="col-lg-6">
                <h2 class="fw-bold mb-3">Meticulous Care in Every Single Package</h2>
                <p class="text-secondary lh-lg mb-3">
                    In our fulfillment center, each order is handled with the highest attention to detail. To ensure products arrive in pristine condition while caring for our planet, we utilize shock-absorbing cushioning and <strong>100% recyclable, eco-friendly kraft packaging</strong>.
                </p>
                <p class="text-secondary lh-lg mb-0">
                    We believe in conscious commerce—reducing our carbon footprint and building a greener tomorrow with every box we ship.
                </p>
            </div>
        </div>
    </section>

    <!-- 4. OUR CORE VALUES (COMPANY CULTURE) -->
    <section class="my-5 py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold mt-1">The Values That Define Us</h2>
            <p class="text-muted mx-auto" style="max-width: 600px;">The foundational guidelines shaping our culture and every decision we make.</p>
        </div>

        <div class="row g-4">
            <!-- Value 1 -->
            <div class="col-md-4">
                <div class="value-pill">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-primary text-white rounded-circle p-2 me-2">01</span>
                        <h5 class="fw-bold mb-0 text-dark">Transparency</h5>
                    </div>
                    <p class="text-muted mb-0 lh-lg">
                        Honest pricing, accurate stock levels, and authentic communication. No hidden fees, no fine print surprises—just clear honesty.
                    </p>
                </div>
            </div>

            <!-- Value 2 -->
            <div class="col-md-4">
                <div class="value-pill">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-success text-white rounded-circle p-2 me-2">02</span>
                        <h5 class="fw-bold mb-0 text-dark">Sustainability</h5>
                    </div>
                    <p class="text-muted mb-0 lh-lg">
                        We actively reduce plastic waste through eco-friendly materials, recyclable boxes, and optimized logistic routes that lower carbon emissions.
                    </p>
                </div>
            </div>

            <!-- Value 3 -->
            <div class="col-md-4">
                <div class="value-pill">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-info text-white rounded-circle p-2 me-2">03</span>
                        <h5 class="fw-bold mb-0 text-dark">Innovation</h5>
                    </div>
                    <p class="text-muted mb-0 lh-lg">
                        Harnessing modern software architecture and web technologies to ensure your digital shopping journey is ultra-fast, intuitive, and enjoyable.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CUSTOMER SATISFACTION & UNBOXING -->
    <section class="my-5">
        <div class="row align-items-center g-5 flex-lg-row-reverse">
            <div class="col-lg-6">
                <div class="story-image-wrap">
                    <img src="~/AboutUsImages/customer-satisfaction.jpg" alt="StoreApp Delighted Customer Unboxing Experience" class="img-fluid" />
                </div>
            </div>
            <div class="col-lg-6">
                <h2 class="fw-bold mb-3">The Joy When You Open Your Package</h2>
                <p class="text-secondary lh-lg mb-3">
                    For us, genuine achievement isn't measured in checkout numbers, but in the smile on your face when your package arrives at your doorstep and you open it.
                </p>
                <p class="text-secondary lh-lg mb-4">
                    From pre-order advice to post-delivery care, we are always just one click away. Your satisfaction is our most valued milestone.
                </p>
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 bg-light rounded-circle text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="fw-bold">Have Questions?</div>
                        <small class="text-muted">Our support team is always eager to help.</small>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. CALL TO ACTION (CTA) & CLOSING -->
    <section class="my-5">
        <div class="cta-banner text-center">
            <h2 class="display-6 fw-bold mb-3">Elevate Your Shopping Experience</h2>
            <p class="lead mb-4 opacity-90 mx-auto" style="max-width: 650px;">
                Explore our curated collection of premium products, enjoy exclusive deals, and discover the StoreApp difference today.
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Products" asp-action="Index" class="btn btn-light btn-lg px-4 py-2 fw-semibold text-primary shadow-sm rounded-pill">
                    Explore Products
                </a>
            </div>
        </div>
    </section>

</div>