@{
    ViewData["Title"] = "Home";
}
@model List<Product>
<head>
    <link rel="stylesheet" href="~/css/home.css"/>
</head>

<div class="container my-5" style="margin-bottom: 1rem !important; margin-top: 1rem !important;">
    <div class="text-center mb-4">
        <h2 class="fw-bold">Featured Products</h2>
        <p class="text-muted">Discover our most popular and handpicked collections.</p>
    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            No featured products available at the moment.
        </div>
    }
    else
    {
        <!-- Slider with left/right navigation arrows wrapper -->
        <div class="featured-carousel-wrapper">
            <div class="owl-carousel owl-theme">
                @foreach (var product in Model)
                {
                    <div class="item">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                            <!-- Product Image -->
                            <img src="@product.ImageUrl" alt="@product.Name" class="card-img-top" style="height: 250px; object-fit: cover;" />
                            
                            <!-- Product Details -->
                            <div class="card-body text-center p-3">
                                <h5 class="card-title fw-bold">@product.Name</h5>
                                <p class="card-text text-muted small text-truncate">@product.Description</p>
                                <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">@product.Price₺</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div class="text-center mt-4" style="margin-top: 0 !important;">
    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary btn-lg px-5 rounded-pill shadow-sm fw-semibold">
        View All Products &rarr;
    </a>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.owl-carousel').owlCarousel({
                loop: true,
                margin: 20,
                nav: true,
                dots: true,
                autoplay: true,
                autoplayTimeout: 3500,
                autoplayHoverPause: true,
                navText: [
                    '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/></svg>',
                    '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/></svg>'
                ],
                responsive: {
                    0: {
                        items: 1
                    },
                    768: {
                        items: 2
                    },
                    992: {
                        items: 3
                    }
                }
            });
        });
    </script>
}